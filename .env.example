# Copy to .env in the repo root. Read by the Makefile. Never commit .env.

# Ethereum Sepolia RPC. Free from Alchemy or Infura (create an app, copy its Sepolia URL).
SEPOLIA_RPC_URL=

# Etherscan API key, for verifying the contract's source on Etherscan. Free at etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Your deployer wallet, imported once with:  cast wallet import deployer --interactive
# The key stays encrypted in Foundry's keystore; you type its password when deploying.
DEPLOYER_ACCOUNT=deployer
DEPLOYER_ADDRESS=
