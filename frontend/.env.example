# Frontend settings. On Vercel, set these in the project's Environment Variables.
# Locally you only need them to point a local build at Sepolia: copy to frontend/.env.
# Leave a setting out (or blank) to use its default.
# All values here are public: they end up in the browser. Never put a private key in a VITE_ variable.

# Network: "anvil" (default, local) or "sepolia".
# VITE_CHAIN=sepolia

# Contract address. Leave unset for local Anvil: the deploy script deploys MockUSDC first,
# so the treasury lands at 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512 on a fresh chain.
# The USDC address is read from the treasury itself, so there's no setting for it.
# `make deployment-info` prints it after a Sepolia deploy.
# VITE_TREASURY_ADDRESS=

# RPC endpoint. Optional; a free Alchemy or Infura Sepolia URL is more reliable than the public default.
# VITE_RPC_URL=

# The standings bot's wallet address (not its key). Defaults to Anvil account 19 locally.
# VITE_REPORTER_ADDRESS=

# Only needed for WalletConnect / mobile wallets. Free at https://cloud.reown.com
# VITE_WALLETCONNECT_PROJECT_ID=
